   }
  }
 },
 {
  "click": {
   "browser": "Cut"
  },
  "button": "right"
 },
 {
  "call": "ui.menuPick",
  "params": {
   "item": "Show/Hide"
  }
 },
 {
  "click": {
   "browser": "Cut"
  },
  "button": "right"
 },
 {
  "call": "ui.menuPick",
  "params": {
   "item": "Show/Hide"
  }
 },
 {
  "click": {
   "browser": "Cut"
  },
  "button": "right"
 },
 {
  "call": "ui.menuPick",
  "params": {
   "item": "Rename"
  }
 },
 {
  "call": "ui.rename",
  "params": {
   "text": "Cutting plane",
