[
  {"note": "#2229: Plane at Angle takes a straight model edge as its axis, and the plane follows the edge when the model changes."},
  {"call": "engine.execute", "params": {"command": "parameters.add", "params": {"name": "h", "expression": "20 mm"}}},
  {"call": "engine.execute", "params": {"command": "solid.box", "params": {"length": 40, "width": 30, "height": "h", "body_name": "Block"}}},
  {"call": "engine.execute", "params": {"command": "construct.plane.offset", "params": {"base": "XY", "offset": "h", "name": "Lid"}}},
  {"call": "ui.view", "params": {"view": "iso"}},
  {"start": "construct.plane.at_angle"},
  {"expect": {"dialog": "AnglePlane"}},
  {"click": {"browser": "Lid"}},
