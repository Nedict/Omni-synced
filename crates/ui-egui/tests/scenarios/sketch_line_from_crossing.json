[
  {"note": "Drawing from where two lines cross snaps to the crossing and holds the new line's start on both lines."},
  {"call": "engine.execute", "params": {"command": "sketch.create", "params": {"plane": "XY"}}},
  {"call": "engine.execute", "params": {"command": "sketch.line", "params": {"points": [[0, 0], [60, 60]]}}},
  {"call": "engine.execute", "params": {"command": "sketch.line", "params": {"points": [[0, 40], [60, 0]]}}},
  {"start": "sketch.line"},
  {"click": {"sketch": [24.4, 23.7]}},
  {"click": {"sketch": [70, 10]}},
  {"key": "Escape"},
{"expect": {"query": {"command": "sketch.inspect", "path": ["curves", 2, "start_at", 0], "value": 24}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["curves", 2, "start_at", 1], "value": 24}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 1, "type"], "value": "point_on_curve"}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 2, "type"], "value": "point_on_curve"}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 3], "value": null}}},
  {"queued": "engine.execute", "params": {"command": "sketch.move_point", "params": {"point": "l2.end", "to": [60, 10]}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["curves", 1, "end_at", 1], "value": 10}}},
  {"expect": {"sketch_status": "solved"}},
  {"note": "A midpoint that is not a crossing is still a Mid snap."},
  {"call": "engine.execute", "params": {"command": "sketch.line", "params": {"points": [[80, 0], [120, 0]]}}},
  {"start": "sketch.line"},
  {"click": {"sketch": [100, 0.3]}},
  {"click": {"sketch": [110, 10]}},
  {"key": "Escape"},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 3, "type"], "value": "midpoint"}}}
]
