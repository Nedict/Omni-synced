<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the typed bridge against the real Rust cdylib and asserts the C#-drives-Rust
       workflows. `cargo xtask csharp` builds the cdylib, then builds and runs this. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SolidCraft.Conformance</AssemblyName>
    <RootNamespace>SolidCraft.Conformance</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SolidCraft.Interop/SolidCraft.Interop.csproj" />
  </ItemGroup>

</Project>
